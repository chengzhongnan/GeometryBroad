{
    "compilerOptions": {
      "outDir": "./dist", // 输出目录
      "rootDir": "./src", // 源文件目录
      "strict": true,
      "module": "commonjs",
      "target": "ES6",
      "esModuleInterop": true,
      "moduleResolution": "node",
      "skipLibCheck": true
    },
    "include": [
      "src/**/*.ts"
    ]
  }
  